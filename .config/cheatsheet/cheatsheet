#!/usr/bin/env python3
"""Searchable cheat sheet built from the markdown tables in ./sheets/*.md

Shown with rofi (theme: ~/.config/rofi/config-cheatsheet.rasi), bound to
Super+N; running it again while it is open closes it.

Every table row becomes one entry: key + action, with its section below.
Headings give the section ("# Git" + "## 2. History" + "### Telescope" ->
"Git › History › Telescope"), so typing "git history telescope" finds that
row. rofi needs every typed word to match, so an optional third column holds
extra search terms (synonyms) that are matched but not shown. Enter copies the
key/command to the clipboard.
"""

import html
import re
import subprocess
import sys
from pathlib import Path

SHEETS = Path(__file__).resolve().parent / "sheets"
THEME = Path.home() / ".config/rofi/config-cheatsheet.rasi"
COLORS = Path.home() / ".config/rofi/colors.rasi"  # regenerated by matugen on wallpaper change
SEP = "\x1e"  # entries are two lines, so they need a separator other than \n


def split_row(line):
    """Split a table row on | that are not inside `code` and not escaped (\\|)."""
    cells, cur, in_code, i = [], "", False, 0
    line = line.strip().removeprefix("|")
    if line.endswith("|") and not line.endswith("\\|"):
        line = line[:-1]
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line) and line[i + 1] == "|":
            cur += "|"
            i += 2
            continue
        if c == "`":
            in_code = not in_code
        if c == "|" and not in_code:
            cells.append(cur)
            cur = ""
        else:
            cur += c
        i += 1
    cells.append(cur)
    return [c.strip().replace("`", "") for c in cells]


def heading(text):
    return re.sub(r"^\d+\.\s*", "", text.strip())


def rows():
    for path in sorted(SHEETS.glob("*.md")):
        title = section = sub = ""
        for line in path.read_text().splitlines():
            if line.startswith("# "):
                title = heading(line[2:])
            elif line.startswith("### "):
                sub = heading(line[4:])
            elif line.startswith("## "):
                section, sub = heading(line[3:]), ""
            elif line.lstrip().startswith("|"):
                cells = split_row(line)
                # skip the header row and the |---|---| separator
                if len(cells) < 2 or re.fullmatch(r"[\s:|-]*", "".join(cells)) or cells[1] == "Action":
                    continue
                where = " › ".join(p for p in (title, section, sub) if p)
                yield where, cells[0], cells[1], cells[2] if len(cells) > 2 else ""


def accent():
    """Matugen's primary color, so keys follow the wallpaper like the rest of the theme."""
    try:
        m = re.search(r"^\s*primary:\s*(#[0-9a-fA-F]{6})", COLORS.read_text(), re.M)
    except OSError:
        m = None
    return m.group(1) if m else None


def close_open_sheet():
    """Kill a running cheatsheet rofi (only rofi processes using our theme)."""
    pids = subprocess.run(["pgrep", "-x", "rofi"], capture_output=True, text=True).stdout.split()
    killed = False
    for pid in pids:
        try:
            args = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if str(THEME).encode() in args:
            subprocess.run(["kill", pid])
            killed = True
    return killed


def main():
    # Super+N while it is open: close it
    if close_open_sheet():
        return

    items = list(rows())
    if not items:
        sys.exit(f"No tables found in {SHEETS}/*.md")

    color = accent()
    key_open = f"<span weight='bold' foreground='{color}'>" if color else "<span weight='bold'>"
    entries = [
        f"{key_open}{html.escape(key)}</span>    {html.escape(action)}\n"
        f"<span size='small' alpha='60%'>{html.escape(section)}</span>"
        + (f"\0meta\x1f{terms}" if terms else "")  # hidden search terms
        for section, key, action, terms in items
    ]
    picked = subprocess.run(
        ["rofi", "-dmenu", "-i", "-markup-rows", "-no-custom", "-eh", "2", "-sep", SEP,
         "-format", "i", "-p", "Cheatsheet", "-theme", str(THEME)],
        input=SEP.join(entries), capture_output=True, text=True,
    ).stdout.strip()

    if picked.isdigit():
        subprocess.run(["wl-copy", items[int(picked)][1]])


if __name__ == "__main__":
    main()
