+        private static string html_to_pango (string input) {
+            if (input.index_of_char ('<') < 0 && input.index_of_char ('&') < 0) {
+                return input;
+            }
+            string text = input;
+            try {
+                var flags = RegexCompileFlags.CASELESS;
+                // Line breaks and paragraphs
+                text = new Regex ("<br\\s*/?>", flags).replace (text, -1, 0, "\n");
+                text = new Regex ("</p>\\s*<p(\\s[^>]*)?>", flags).replace (text, -1, 0, "\n\n");
+                text = new Regex ("</?(p|div)(\\s[^>]*)?>", flags).replace (text, -1, 0, "");
+                // Links: keep the text, drop the tag (Pango has no <a>)
+                text = new Regex ("<a(\\s[^>]*)?>|</a>", flags).replace (text, -1, 0, "");
+                // HTML-only formatting tags -> Pango equivalents
+                text = new Regex ("<(/?)strong>", flags).replace (text, -1, 0, "<\\1b>");
+                text = new Regex ("<(/?)em>", flags).replace (text, -1, 0, "<\\1i>");
+                // HTML entities that XML/Pango doesn't define
+                text = new Regex ("&nbsp;", flags).replace_literal (text, -1, 0, " ");
+            } catch (RegexError e) {
+                stderr.printf ("html_to_pango: %s\n", e.message);
+                return input;
+            }
+            return text.strip ();
+        }
